{
  "ReverseProxy": {
    "Routes": {
      "attendance-api": { "ClusterId": "api", "Match": { "Path": "/api/{**catch-all}" } }
    },
    "Clusters": { "api": { "Destinations": { "primary": { "Address": "http://localhost:5080/" } } } }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
